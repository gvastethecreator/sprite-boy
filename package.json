{
  "name": "sprite-boy",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "protobufjs": "8.7.2",
    "undici": "8.10.0",
    "ws": "8.21.3",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "vite": "8.2.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "models:status": "bun scripts/studio-model-status.mjs",
    "models:setup": "bun scripts/studio-model-setup.mjs",
    "control:bridge": "bun scripts/studio-control-bridge.mjs",
    "control:mcp": "bun scripts/studio-control-mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && oxlint .",
    "clean": "rimraf dist logs",
    "build:log": "node scripts/log-runner.mjs build \"vite build\"",
    "test:log": "node scripts/log-runner.mjs test \"vitest run\"",
    "lint:log": "node scripts/log-runner.mjs lint \"oxlint .\""
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "gifshot": "^0.4.5",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "mediabunny": "1.54.0",
    "onnxruntime-web": "1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
